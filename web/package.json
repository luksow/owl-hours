{
  "name": "owlhours-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/budget.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "node scripts/render-assets.mjs",
    "screens": "node scripts/render-screens.mjs",
    "test:e2e": "playwright test",
    "test:e2e:subpath": "playwright test -c playwright.subpath.config.js",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/mr-dafoe": "5.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@scala-js/vite-plugin-scalajs": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  }
}
